; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.

config_version=5

[application]

config/name="Snookering"
run/main_scene="res://scenes/match.tscn"
config/features=PackedStringArray("4.7", "C#", "Forward Plus")

[autoload]

Debug="*res://scripts/debug/DebugAutoload.cs"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080

[dotnet]

project/assembly_name="Snookering.Game"

[rendering]

renderer/rendering_method="forward_plus"
anti_aliasing/quality/use_taa=true
lights_and_shadows/positional_shadow/atlas_size=8192
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=3
textures/default_filters/anisotropic_filtering_level=2
environment/ssao/quality=3
environment/ssil/quality=3
